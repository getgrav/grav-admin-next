    "@uppy/image-editor": "^4.2.0",
    "@uppy/svelte": "^5.2.0",
    "@uppy/xhr-upload": "^5.2.0",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "intl-messageformat": "^11.2.2",
    "js-yaml": "^4.1.1",
    "lucide-svelte": "^1.0.1",
    "marked": "^17.0.5",
    "speakingurl": "^14.0.1",
    "svelte-sonner": "^1.1.0",
    "tailwind-merge": "^3.5.0",
